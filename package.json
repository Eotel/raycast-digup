{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "digup-launcher",
  "title": "DigUp",
  "description": "Open DigUp search from Raycast.",
  "version": "1.0.0",
  "type": "module",
  "icon": "icon.png",
  "author": "Eotel",
  "license": "MIT",
  "platforms": ["macOS"],
  "categories": ["Applications", "Productivity"],
  "commands": [
    {
      "name": "open-search",
      "title": "Search with DigUp",
      "description": "Open DigUp search",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "appPath",
      "title": "DigUp App Path",
      "description": "Path to DigUp.app, if Raycast cannot find it.",
      "type": "textfield",
      "required": false,
      "placeholder": "/Applications/DigUp.app"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "2.8.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "22.19.17",
    "typescript": "5.9.3"
  }
}
